# SMTP Configuration
# Choose one SMTP provider below

# ===== OPTION 1: Gmail (Free) =====
# 1. Enable 2FA on your Gmail account
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Copy the 16-character password below
EMAIL_SERVICE=gmail
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ===== OPTION 2: Generic SMTP Server =====
# (Uncomment and configure for services like SendGrid, AWS SES, etc.)
# EMAIL_SERVICE=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password
# SMTP_FROM_EMAIL=noreply@example.com

# ===== OPTION 3: SendGrid =====
# (Uncomment to use SendGrid)
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# ===== Common Configuration =====
ADMIN_EMAIL=careers@voxmation.com
APP_URL=http://localhost:5000

# ===== ElevenLabs (existing) =====
ELEVENLABS_API_KEY=your-api-key-here

# ===== Database (future) =====
# DATABASE_URL=postgresql://user:password@localhost:5432/voxmation
