# Voxmation Development Environment Variables
# Copy this file to .env.development and fill in your values
# DO NOT COMMIT .env.development to version control

# ===== CORE CONFIGURATION =====
NODE_ENV=development
PORT=3001
DEBUG=true
LOG_LEVEL=debug

# ===== FRONTEND CONFIGURATION =====
VITE_API_URL=http://localhost:3001
VITE_SENTRY_ENVIRONMENT=development

# ===== SUPABASE CONFIGURATION =====
# Get these from: https://app.supabase.com → Settings → Database
VITE_SUPABASE_URL=https://your-local-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===== LOCAL DATABASE CONFIGURATION (if not using Supabase) =====
# POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/voxmation
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=voxmation
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# ===== EMAIL SERVICE (RESEND) =====
# Sign up at: https://resend.com → API Keys
RESEND_API_KEY=re_test_your_key_here
RESEND_FROM_EMAIL=noreply@localhost:5000

# ===== VOICE SERVICE (ELEVENLABS) =====
# Sign up at: https://elevenlabs.io → API Keys
# Voice IDs: EXAVITQu4vr4xnSDxMaL (Bella), TxGEqnHWrfWFTfGW9XjX (Josh), etc.
ELEVENLABS_API_KEY=sk_test_your_key_here

# ===== SMS SERVICE (TWILIO) =====
# Sign up at: https://www.twilio.com
# Console: Account SID, Auth Token, Phone Numbers
# For development, test numbers:
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ===== PAYMENT PROCESSING (STRIPE) =====
# Sign up at: https://stripe.com → Developers → API Keys
# Use test keys (starts with pk_test_ and sk_test_)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== ERROR TRACKING (SENTRY) =====
# Sign up at: https://sentry.io → Create Project → React (frontend)
# DSN format: https://key@sentry.io/projectid
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/123456
SENTRY_ENVIRONMENT=development

# ===== ANALYTICS (OPTIONAL) =====
# Sign up at: https://segment.com
VITE_SEGMENT_WRITE_KEY=your_segment_write_key_here

# ===== GOOGLE OAUTH (OPTIONAL) =====
# Go to: https://console.cloud.google.com → Create Project
# Create OAuth 2.0 Client ID → Download credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# ===== REDIS CACHE (LOCAL) =====
REDIS_URL=redis://localhost:6379

# ===== FILE UPLOADS =====
# Local development uses ./uploads directory
UPLOADS_DIR=./uploads
MAX_FILE_SIZE=52428800

# ===== FRONTEND CONFIGURATION =====
VITE_APP_NAME=Voxmation
VITE_APP_VERSION=0.0.1
VITE_ENABLE_DEVTOOLS=true

# ===== DOCKER CONFIGURATION (if using Docker Compose) =====
# Leave these as defaults for local development
DOCKER_TARGET=development
RESTART_POLICY=no

# ===== DATABASE VOLUMES PATH =====
VOLUMES_PATH=./data
