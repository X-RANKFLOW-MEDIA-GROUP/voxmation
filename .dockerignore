# =====================================================================
# BUILD CONTEXT EXCLUSIONS - Reduce Docker image size and build time
# =====================================================================

# Version Control
.git
.gitignore
.gitattributes

# Node Modules (will be installed in container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-lock.yaml.bak
lerna-debug.log*

# Package Manager Locks (Docker will install fresh)
package-lock.json.bak
yarn.lock.bak

# Build Artifacts (will be rebuilt in container)
dist/
dist-ssr/
build/
out/
.next/

# Development Files
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*.swn
*.sw?
*.sublime-project
*.sublime-workspace
.env.local
.env.*.local
*.pem

# Documentation and Markdown (keep technical docs needed for build)
README.md
CHANGELOG.md
CONTRIBUTING.md
LICENSE
docs/
# Keep performance and setup docs
!PERFORMANCE_OPTIMIZATIONS.md
# Keep other .md files that might be documentation only
*.md

# Testing
test/
tests/
__tests__/
coverage/
.nyc_output/
*.test.ts
*.test.tsx
*.test.js
*.test.jsx
*.spec.ts
*.spec.tsx
*.spec.js
*.spec.jsx
vitest.config.ts

# CI/CD
.github/
.gitlab-ci.yml
.circleci/
.travis.yml
jenkins/
Jenkinsfile

# Docker Files (don't copy into image)
Dockerfile*
.dockerignore
docker-compose*.yml
docker-compose*.yaml

# Database
.db
*.db
*.sqlite
*.sqlite3
postgres_data/
redis_data/

# Logs
logs/
*.log
npm-debug.log
pnpm-debug.log
yarn-error.log

# IDE/Editor Temp Files
.editorconfig
*.bak
*.tmp
*~

# OS Files
Thumbs.db
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Example and Config Files (not needed in image)
.env.example
.env.development
.env.test
.editorconfig
.prettierrc*
.eslintrc*
eslint.config.js
tsconfig*.json
vite.config.ts.bak

# Cache and Temp
.cache/
.tmp/
.temp/
.turbo/
.next/

# Optional npm cache directory
.npm/

# Optional REPL history
.node_repl_history

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Misc
*.orig
.env.production.local
.NOTES
.todo
todo.txt

# Large files
*.tar
*.tar.gz
*.zip
*.rar
*.iso

# Development Documentation
ADMIN_*.md
AUTOMATIONS_*.md
BILLING_*.md
SETUP_*.md
