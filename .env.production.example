# Voxmation Production Environment Variables
# Copy this file to .env.production and fill in your values
# DO NOT COMMIT .env.production to version control
# Treat these values as secrets - secure them carefully

# ===== CORE CONFIGURATION =====
NODE_ENV=production
PORT=3001
DEBUG=false
LOG_LEVEL=warn

# ===== FRONTEND CONFIGURATION =====
VITE_API_URL=https://api.yourdomain.com
VITE_SENTRY_ENVIRONMENT=production
VITE_APP_NAME=Voxmation
VITE_APP_VERSION=1.0.0

# ===== SUPABASE CONFIGURATION =====
# Get these from: https://app.supabase.com → Settings → Database
# Use production Supabase project (not development)
VITE_SUPABASE_URL=https://your-production-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===== DATABASE CONFIGURATION =====
# For Supabase-managed PostgreSQL, connection handled by VITE_SUPABASE_URL
# For self-managed PostgreSQL:
# POSTGRES_URL=postgresql://user:password@host:5432/voxmation
# Keep password in secure secrets manager, not in .env

# ===== EMAIL SERVICE (RESEND) =====
# Sign up at: https://resend.com → API Keys
# IMPORTANT: Verify your custom domain in Resend for production
RESEND_API_KEY=re_live_your_production_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ===== VOICE SERVICE (ELEVENLABS) =====
# Sign up at: https://elevenlabs.io → API Keys
# Production tier recommended for better voice quality and limits
ELEVENLABS_API_KEY=sk_live_REPLACE_WITH_YOUR_KEY

# ===== SMS SERVICE (TWILIO) =====
# Sign up at: https://www.twilio.com
# Upgrade from trial to production account for unlimited SMS
# Use actual phone numbers, not test numbers
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_production_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ===== PAYMENT PROCESSING (STRIPE) =====
# Sign up at: https://stripe.com → Developers → API Keys
# CRITICAL: Use LIVE keys (starts with pk_live_REPLACE_WITH_YOUR_KEY and sk_live_REPLACE_WITH_YOUR_KEY), not test keys
# Replace with actual keys from Stripe dashboard
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_KEY
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_live_REPLACE_WITH_YOUR_KEY

# ===== ERROR TRACKING (SENTRY) =====
# Sign up at: https://sentry.io → Create Project
# Use separate production project for Sentry
SENTRY_DSN=https://your_production_key@sentry.io/production_projectid
SENTRY_ENVIRONMENT=production
# Optional: Enable performance monitoring
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# ===== ANALYTICS (OPTIONAL) =====
# Sign up at: https://segment.com
# Use production API key
VITE_SEGMENT_WRITE_KEY=your_production_segment_key_here

# ===== GOOGLE OAUTH (OPTIONAL) =====
# Go to: https://console.cloud.google.com → Create Project
# Create OAuth 2.0 Client ID for production domain
# Update authorized URLs to production domain
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_production_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_production_client_secret_here

# ===== REDIS CONFIGURATION =====
# Production should use managed Redis or self-hosted with replication
# Azure Cache for Redis: redis-instance.redis.cache.windows.net:6379
# AWS ElastiCache: your-cluster.xxxxx.cache.amazonaws.com:6379
# Heroku Redis: redis://url.redis.upstash.io:port
REDIS_URL=redis://:password@your-redis-host.com:6379

# ===== FILE UPLOADS =====
# Production should use S3, Azure Blob Storage, or similar
# Or use persistent volume in Docker/Kubernetes
UPLOADS_DIR=/data/uploads
MAX_FILE_SIZE=52428800

# ===== SSL/TLS CONFIGURATION =====
# Should be handled by reverse proxy (Nginx, CloudFlare), but configure here if needed
SSL_CERT_PATH=/etc/ssl/certs/yourdomain.com.crt
SSL_KEY_PATH=/etc/ssl/private/yourdomain.com.key

# ===== DOCKER CONFIGURATION =====
NODE_IMAGE_VERSION=22-alpine
DOCKER_TARGET=production
RESTART_POLICY=unless-stopped

# ===== DATABASE BACKUPS =====
# Configure automated backups in Supabase or your database provider
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30

# ===== SECURITY HEADERS =====
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== SESSION & AUTHENTICATION =====
SESSION_SECRET=your_long_random_session_secret_here_min_32_chars
JWT_SECRET=your_long_random_jwt_secret_here_min_32_chars
JWT_EXPIRY=7d

# ===== DATABASE VOLUMES PATH (DOCKER) =====
VOLUMES_PATH=/mnt/data

# ===== PROXY CONFIGURATION (if behind proxy) =====
# HTTP_PROXY=http://proxy.example.com:3128
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1,10.0.0.0/8

# ===== MONITORING & LOGGING =====
# Should send logs to centralized service (CloudWatch, Datadog, etc.)
LOG_SERVICE=sentry
LOG_FORMAT=json
LOG_LEVEL=warn

# ===== EMAIL RATE LIMITS =====
EMAIL_RATE_LIMIT=50
EMAIL_RATE_LIMIT_WINDOW=3600

# ===== SMS RATE LIMITS =====
SMS_RATE_LIMIT=10
SMS_RATE_LIMIT_WINDOW=3600

# ===== API RATE LIMITS =====
API_RATE_LIMIT=1000
API_RATE_LIMIT_WINDOW=3600

# ===== FEATURE FLAGS (OPTIONAL) =====
# FEATURE_CAMPAIGNS_ENABLED=true
# FEATURE_AUTOMATIONS_ENABLED=true
# FEATURE_ANALYTICS_ENABLED=true
# FEATURE_INTEGRATIONS_ENABLED=true
