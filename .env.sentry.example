# Sentry Configuration
# Get your DSN from: https://sentry.io/settings/[organization]/projects/[project]/keys/dsn/

# Server-side Sentry DSN (Express.js API)
SENTRY_DSN=https://your-key@your-project.ingest.sentry.io/your-project-id

# Client-side Sentry DSN (Next.js & React)
# Note: This is a public key, safe to expose in client code
NEXT_PUBLIC_SENTRY_DSN=https://your-key@your-project.ingest.sentry.io/your-project-id

# Environment for error tracking
NODE_ENV=development
